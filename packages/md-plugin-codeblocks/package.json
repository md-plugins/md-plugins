{
  "name": "@md-plugins/md-plugin-codeblocks",
  "version": "2.0.1",
  "description": "A markdown-it plugin for code blocks.",
  "keywords": [
    "markdown-it",
    "quasarframework",
    "types",
    "vue"
  ],
  "homepage": "https://github.com/md-plugins",
  "bugs": {
    "url": "https://github.com/md-plugins/md-plugins/issues"
  },
  "license": "MIT",
  "author": "hawkeye64 <galbraith64@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-plugins/md-plugins.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && node ../../scripts/ensure-obuild-types.mjs",
    "clean": "rm -rf dist/ node_modules/",
    "test": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.4.2",
    "@shikijs/twoslash": "^4.4.2",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@md-plugins/shared": "workspace:*",
    "markdown-it": "^15.0.0"
  },
  "peerDependencies": {
    "markdown-it": "^15.0.0"
  }
}
