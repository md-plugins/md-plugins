{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "esnext"
  },
  "include": [
    "./src/index.ts",
    "./src/install.ts",
    "./src/api/**/*.ts",
    "./src/bin/**/*.ts",
    "./src/check/**/*.ts",
    "./src/ssg/**/*.ts"
  ],
  "exclude": ["./node_modules"]
}
