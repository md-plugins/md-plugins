{
  "name": "@md-plugins/search-ui",
  "version": "0.1.0-rc.15",
  "description": "Framework-agnostic search UI and static search provider for md-plugins documentation search indexes.",
  "keywords": [
    "algolia",
    "docs-search",
    "markdown",
    "md-plugins",
    "meilisearch",
    "search",
    "static-site-search",
    "web-components"
  ],
  "homepage": "https://github.com/md-plugins",
  "bugs": {
    "url": "https://github.com/md-plugins/md-plugins/issues"
  },
  "license": "MIT",
  "author": "hawkeye64 <galbraith64@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-plugins/md-plugins.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "clean": "rm -rf dist/ node_modules/",
    "prepack": "pnpm build"
  }
}
