{
  "name": "mdplugins_docs",
  "version": "0.1.0-beta.28",
  "private": true,
  "description": "Documentation site for MD-Plugins, Q-Press, and the Vite/Markdown plugin ecosystem.",
  "author": "Jeff <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "check-types": "quasar prepare && vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar prepare && quasar build",
    "build:ssg": "quasar prepare && quasar build && node ../qPress/bin/qpress-ssg.js",
    "build:ssg:renderer": "quasar prepare && quasar build -m ssr",
    "prerender:ssg": "node ../qPress/bin/qpress-ssg.js",
    "build:ssr": "quasar prepare && quasar build -m ssr",
    "start:ssr": "cd dist/ssr && node index.js",
    "prepared": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "2.0.0",
    "mermaid": "^11.15.0",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "shiki": "^4.2.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@md-plugins/md-plugin-headers": "workspace:*",
    "@md-plugins/quasar-app-extension-q-press": "workspace:*",
    "@md-plugins/vite-examples-plugin": "workspace:*",
    "@md-plugins/vite-md-plugin": "workspace:*",
    "@md-plugins/vite-ssg-plugin": "workspace:*",
    "@quasar/app-vite": "3.0.0-beta.44",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^25.9.2",
    "autoprefixer": "^10.5.0",
    "markdown-it-container": "^4.0.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-checker": "^0.14.1",
    "vue-tsc": "^3.3.4"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.3.0"
  },
  "productName": "@md-plugins"
}
