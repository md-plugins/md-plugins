{
  "name": "mdplugins_docs",
  "version": "2.0.0",
  "private": true,
  "description": "Documentation site for MD-Plugins, Q-Press, and the Vite/Markdown plugin ecosystem.",
  "author": "Jeff <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "check:qpress": "node ../qPress/bin/qpress.js check",
    "check-types": "quasar prepare && vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar prepare && quasar build",
    "build:ssg": "quasar prepare && quasar build && node ../qPress/bin/qpress.js ssg",
    "build:ssg:renderer": "quasar prepare && quasar build -m ssr",
    "prerender:ssg": "node ../qPress/bin/qpress.js ssg",
    "preview:ssg": "quasar serve dist/spa --history",
    "build:ssr": "quasar prepare && quasar build -m ssr",
    "start:ssr": "cd dist/ssr && node index.js",
    "prepared": "quasar prepare"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@md-plugins/search-ui": "workspace:*",
    "@quasar/extras": "2.0.2",
    "hono": "4.13.0",
    "pinia": "^4.0.2",
    "quasar": "^2.23.5",
    "serialize-javascript": "7.0.7",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@md-plugins/md-plugin-headers": "workspace:*",
    "@md-plugins/quasar-app-extension-q-press": "workspace:*",
    "@md-plugins/vite-examples-plugin": "workspace:*",
    "@md-plugins/vite-md-plugin": "workspace:*",
    "@md-plugins/vite-search-plugin": "workspace:*",
    "@md-plugins/vite-ssg-plugin": "workspace:*",
    "@quasar/app-vite": "3.3.1",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.16.1",
    "sass-embedded": "1.100.0",
    "shiki": "^4.4.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.3.0"
  },
  "productName": "@md-plugins"
}
