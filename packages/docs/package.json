{
  "name": "mdplugins_docs",
  "version": "0.1.0-beta.5",
  "private": true,
  "description": "Docs site for @md-plugins, the home of Q-Press!",
  "author": "Jeff <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "check-types": "quasar prepare && vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar prepare && quasar build",
    "build:ssr": "quasar prepare && quasar build -m ssr",
    "start:ssr": "cd dist/ssr && node index.js",
    "prepared": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "quasar": "^2.19.3",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@md-plugins/md-plugin-headers": "workspace:*",
    "@md-plugins/shared": "workspace:*",
    "@md-plugins/vite-examples-plugin": "workspace:*",
    "@md-plugins/vite-md-plugin": "workspace:*",
    "@quasar/app-vite": "3.0.0-beta.26",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "autoprefixer": "^10.5.0",
    "markdown-it-container": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.13.0",
    "vue-tsc": "^3.3.1"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.3.0"
  },
  "productName": "@md-plugins"
}
