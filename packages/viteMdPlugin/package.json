{
  "name": "@md-plugins/vite-md-plugin",
  "version": "1.1.0",
  "description": "A very opinionated Vite plugin for @md-plugins.",
  "keywords": [
    "markdown-it",
    "quasarframework",
    "utils",
    "vite",
    "vite-plugin",
    "vue"
  ],
  "homepage": "https://github.com/md-plugins",
  "bugs": {
    "url": "https://github.com/md-plugins/md-plugins/issues"
  },
  "license": "MIT",
  "author": "hawkeye64 <galbraith64@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-plugins/md-plugins.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild && node ../../scripts/ensure-obuild-types.mjs",
    "clean": "rm -rf dist/ node_modules/",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@md-plugins/md-plugin-blockquote": "workspace:*",
    "@md-plugins/md-plugin-codeblocks": "workspace:*",
    "@md-plugins/md-plugin-containers": "workspace:*",
    "@md-plugins/md-plugin-frontmatter": "workspace:*",
    "@md-plugins/md-plugin-headers": "workspace:*",
    "@md-plugins/md-plugin-image": "workspace:*",
    "@md-plugins/md-plugin-imports": "workspace:*",
    "@md-plugins/md-plugin-inlinecode": "workspace:*",
    "@md-plugins/md-plugin-link": "workspace:*",
    "@md-plugins/md-plugin-mermaid": "workspace:*",
    "@md-plugins/md-plugin-steps": "workspace:*",
    "@md-plugins/md-plugin-table": "workspace:*",
    "@md-plugins/md-plugin-title": "workspace:*",
    "@md-plugins/shared": "workspace:*",
    "markdown-it": "^14.3.0",
    "markdown-it-ins": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "vite": "^8.1.4"
  },
  "peerDependencies": {
    "markdown-it": "^14.2.0"
  }
}
