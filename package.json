{
  "name": "@md-plugins/mono-repo",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "",
  "keywords": [
    "markdown",
    "markdown-it",
    "quasar",
    "quasarframework",
    "vue"
  ],
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r --stream build",
    "dev": "vitest",
    "check-types": "pnpm check-types:packages && pnpm --filter mdplugins_docs check-types",
    "check-types:packages": "tsc -p tsconfig.json --noEmit --skipLibCheck",
    "deep": "ncu --deep",
    "clean": "pnpm -r --stream clean",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "ci:publish": "pnpm -r publish --access public --publish-branch dev",
    "ci:publish:beta": "pnpm -r publish --access public --publish-branch dev --tag beta",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.64.0",
    "typescript": "~5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.1.0"
  },
  "packageManager": "pnpm@11.1.0",
  "access": "private"
}
