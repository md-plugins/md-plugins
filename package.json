{
  "name": "@md-plugins/mono-repo",
  "version": "0.1.0-beta.20",
  "private": true,
  "description": "",
  "keywords": [
    "markdown",
    "markdown-it",
    "quasar",
    "quasarframework",
    "vue"
  ],
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r --stream build",
    "build:packages": "pnpm --filter './packages/*' --filter '!mdplugins_docs' --stream build",
    "dev": "vitest",
    "check-types": "pnpm check-types:packages && pnpm build:packages && pnpm --filter mdplugins_docs check-types",
    "check-types:packages": "tsc -p tsconfig.json --noEmit --skipLibCheck",
    "deep": "ncu --configFilePath . --packageFile '{package.json,packages/*/package.json}'",
    "clean": "pnpm -r --stream clean",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:all": "pnpm verify",
    "verify": "pnpm verify:fast && pnpm verify:build",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm test",
    "verify:build": "pnpm build && pnpm check-types",
    "ci:publish": "pnpm -r publish --access public --publish-branch dev",
    "ci:publish:beta": "pnpm -r publish --access public --publish-branch dev --tag beta",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "npm-check-updates": "^22.2.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "~6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.5.0",
  "access": "private"
}
